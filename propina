<!DOCTYPE html>
<html lang="en">

body{
    font-family:Verdana,sans-serif; background: #f3f7f4;color: #1d2b24;max-width: 400px;margin: 300px auto;padding: 0 16px;
}
h1{
    color: #1f6f4a;
}
label{
    display: block;margin-top: 14px;font-weight: bold;
}
input,select{
    width: 100%;padding: 8px;font-size: 16px;box-sizing:border-box;
}


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="propina.css">
</head>

<body>


    <h1>Calculador da le pagina </h1>
    <label for="cuenta">Importe la cuenta(€)</label>
    <input id="cuenta" type="number">

    <label for="porcentaje">propina</label>
    <select id="porcentaje">
        <option value="5">5 %</option>
        <option value="10" selected>10 %</option>
        <option value="15">15 %</option>
    </select>
    <button id="calcular" type="button">calcular</button>
    <p>propina: <span id="propina">0</span>€</p>


    <script src="propina.js"></script>
</body>

</html>
